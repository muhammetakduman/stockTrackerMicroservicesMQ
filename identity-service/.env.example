# ============================================================
# identity-service — .env.example (BUNU KOPYALAYIP .env YAP)
# Gerçek değerleri .env dosyasına yaz, bunu commit edebilirsin.
# ============================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# JWT — RSA key üretimi için README'ye bak
JWT_PRIVATE_KEY_PATH=classpath:certs/dev-private.pem
JWT_PUBLIC_KEY_PATH=classpath:certs/dev-public.pem
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Admin kullanıcı (sadece dev)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

