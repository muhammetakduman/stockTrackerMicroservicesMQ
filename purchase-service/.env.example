# ============================================================
# purchase-service — .env.example (BUNU KOPYALAYIP .env YAP)
# ============================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_NAME=purchase_db
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# JWT — RSA public key konumu
JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt-public.pem

# Messaging
PURCHASE_EXCHANGE=purchase.exchange
PURCHASE_ROUTING_KEY=purchase.created
