# ============================================================
# inventory-service — .env.example (BUNU KOPYALAYIP .env YAP)
# Gerçek değerleri .env dosyasına yaz, bunu commit edebilirsin.
# ============================================================

# Application
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=inventory_db
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# JWT (RSA public key - no private key here)
JWT_PUBLIC_KEY_LOCATION=classpath:certs/dev-public.pem
